generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// IIPE App4 (Facilities Booking) — sanapp_facilities_db
// Fully independent: its own users (provisioned from SSO identity),
// its own roles, and its own business data.
//
// Time handling: ALL times are Indian Standard Time (IST, UTC+5:30).
// Bookings store a plain calendar date (YYYY-MM-DD) plus start/end as
// minutes-from-midnight IST. There is no DateTime arithmetic across
// timezones anywhere — the server derives the current IST date/minute
// with a fixed UTC+5:30 offset and compares integers only.
// ------------------------------------------------------------------

enum Role {
  ADMIN // app-admin: manages buildings, facilities, eligibility, approvers, POCs
  USER // regular user: self-service bookings of 15 min – 3 hours
}

enum BookingType {
  SELF // user books for themselves (15 min – 3 hours)
  ON_BEHALF // an APPROVER blocks a slot for someone else (15 min – 3 hours, description + optional PDF)
  LONG // a POC blocks a slot longer than 3 hours on their own name (description + optional PDF)
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model AppUser {
  id          String    @id @default(uuid())
  ssoUserId   String?   @unique // subject from the central SSO (set on first login)
  username    String    @unique
  name        String
  email       String?
  // Primary role from the central SSO (STAFF_TEACHING, STAFF_NON_TEACHING,
  // STUDENT, SCHOLAR, GUEST). Stored at login so facility eligibility
  // (which primary roles may book) can be enforced locally.
  primaryRole String?
  role        Role      @default(USER)
  // DEPRECATED — POC/approval access is now scoped per building and per
  // facility (BuildingPoc / FacilityPoc). The columns are kept only so old
  // databases keep working; no code reads them anymore.
  isApprover  Boolean   @default(false)
  isPoc       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[] @relation("Booker")
  onBehalf    Booking[] @relation("ForUser")
  cancellations Booking[] @relation("CancelledBy")
  buildingPocs  BuildingPoc[]
  facilityPocs  FacilityPoc[]
}

model Building {
  id          String     @id @default(uuid())
  name        String
  code        String? // short code, e.g. "LIB", "MB"
  description String?
  location    String? // e.g. "Main Campus, Block A"
  // Default maximum booking duration (minutes) for every facility in this
  // building. NULL = no building cap (facility/platform caps apply).
  maxMinutes  Int?
  order       Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  facilities  Facility[]
  pocs        BuildingPoc[]
}

// Building-level POC. A building POC is automatically POC of every facility
// in the building (propagated as FacilityPoc rows with fromBuilding = true),
// including facilities added later.
model BuildingPoc {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  userId     String
  user       AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([buildingId, userId])
}

model Facility {
  id           String    @id @default(uuid())
  buildingId   String
  building     Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  capacity     Int?
  // Which SSO primary roles may book this facility. Empty = everyone.
  allowedRoles String[]  @default([])
  // Maximum booking duration (minutes) for this facility, overriding the
  // building cap. NULL = use the building cap / platform default.
  maxMinutes   Int?
  // Per-primary-role maximums (role -> maxMinutes), overriding maxMinutes.
  roleLimits   FacilityRoleLimit[]
  // Whether AV technician support requests are allowed for this facility
  hasAvSupport Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  bookings     Booking[]
  pocs         FacilityPoc[]
  notifyConfig FacilityNotifyConfig?
}

// Facility-level POC. Rows with fromBuilding = true were auto-added because
// the user is a POC of the facility's building; they are removed again when
// the building POC is removed. Rows with fromBuilding = false were added
// explicitly for this single facility.
model FacilityPoc {
  id          String   @id @default(uuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId      String
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromBuilding Boolean @default(false)
  createdAt   DateTime @default(now())

  @@unique([facilityId, userId])
}

model Booking {
  id         String        @id @default(uuid())
  // Human-friendly booking reference (e.g. "BK-20260916-X4F2K9"). Carried by
  // the FIRST slot of each booking submission group (the group's canonical
  // code); other slots resolve their display code through the shared batchId.
  code       String? @unique
  facilityId String
  facility   Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  // Submission group: all slots confirmed in one multi-range submission share
  // one batchId, so they can be shown as a single "booking". NULL for slots
  // created before batching (each is its own booking).
  batchId    String?
  // The user who made the booking.
  userId     String
  user       AppUser       @relation("Booker", fields: [userId], references: [id], onDelete: Cascade)
  // For ON_BEHALF bookings: the user the slot is blocked FOR (null for SELF/LONG).
  forUserId  String?
  forUser    AppUser?      @relation("ForUser", fields: [forUserId], references: [id], onDelete: SetNull)
  type       BookingType   @default(SELF)
  status     BookingStatus @default(CONFIRMED)
  // Slot — IST. date is the START day and endDate the END day (both plain
  // YYYY-MM-DD); startMin/endMin are minutes from midnight IST (0..1440).
  // A same-day slot has endDate === date. Multi-day/overnight slots (e.g.
  // 23:30 on day D → 01:00 on day D+1) span across endDate.
  date       String
  endDate    String   @default("")
  startMin   Int
  endMin     Int
  purpose    String? // required for ON_BEHALF and LONG bookings
  isPublicPurpose Boolean @default(false)
  // Optional PDF attachment (max 1 MB) — stored in the DB so it survives
  // redeploys and stays inside the application's own database.
  pdf        Bytes?
  pdfName    String?
  isPublicAttachment Boolean @default(false)
  needAvSupport      Boolean @default(false)
  createdAt  DateTime      @default(now())
  // Audit trail — life-cycle events (created / edited / cancelled).
  events      BookingEvent[]
  // Email-notify digest state (one row per booking when notifiers want mails).
  notifyState BookingNotifyState?
  // Cancellation history — who cancelled, when, and why (set on cancel).
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   AppUser?      @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelReason  String?
  @@index([facilityId, date, status])
  @@index([userId, date])
}

// Per-facility, per-primary-role maximum booking duration (minutes).
model FacilityRoleLimit {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  role       String // SSO primary role (STAFF_TEACHING, STUDENT, ...)
  maxMinutes Int
  @@unique([facilityId, role])
}

// ---------------------------------------------------------------------------
// Booking audit history — every life-cycle event of every slot/booking.
// Written by the app on create / edit / cancel; never edited after the fact.
// Powers the admin's booking-history view and the booker's own edit history
// in My Bookings.
// ---------------------------------------------------------------------------
model BookingEvent {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // CREATED | EDITED | CANCELLED
  kind      String
  at        DateTime @default(now())
  // Who did it (denormalised snapshot; survives user deletion).
  actorId       String?
  actorName     String?
  actorUsername String?
  // EDITED: JSON array of {field, before, after} pairs.
  changes   String?
  // CANCELLED: free-text reason.
  reason    String?

  @@index([bookingId, at])
}

// ---------------------------------------------------------------------------
// Per-facility notify configuration (the app admin decides, per facility):
//   notifyOnSlotBooked — email the notifiers whenever a slot of the facility
//                        is booked / edited / cancelled.
//   notifyOnAvChange   — email the notifiers whenever the AV-support request
//                        of a booking is added / edited / removed.
// Notifiers receive ONE digest email per booking (keyed by the booking code):
// when another slot joins the same booking, the same notification is UPDATED
// (re-sent with the full slot list) instead of sending a mail per slot.
// ---------------------------------------------------------------------------
model FacilityNotifyConfig {
  id                 String   @id @default(uuid())
  facilityId         String   @unique
  facility           Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  notifyOnSlotBooked Boolean  @default(false)
  notifyOnAvChange   Boolean  @default(false)
  // Email the person who MADE a booking whenever one of their slots on this
  // facility is created, edited or cancelled.
  notifyBookingUser  Boolean  @default(false)
  // Email the person a slot was blocked FOR whenever a POC / app admin books
  // on their behalf.
  notifyForUser      Boolean  @default(false)
  // Notifier email addresses (comma / newline separated in the admin UI).
  notifyEmails       String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Digest state per booking: notifiers get ONE mail per booking; when another
// slot joins the booking the mail is re-sent with the updated slot list.
model BookingNotifyState {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  code      String
  // Snapshot of the last emailed body so unchanged bookings are not re-sent.
  lastBody  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Booking dashboard configuration — the app admin decides WHICH facilities are
// shown on the "next week bookings" dashboard and WHO may see it.
// allowedUsernames empty = every app admin sees the dashboard; otherwise only
// admins whose username is listed (or who hold the central SUPER_ADMIN role).
// ---------------------------------------------------------------------------
model DashboardConfig {
  id               String   @id @default(uuid())
  // Single-row config (id = "default").
  facilityIds      String[] @default([])
  allowedUsernames String[] @default([])
  updatedAt        DateTime @updatedAt
}
