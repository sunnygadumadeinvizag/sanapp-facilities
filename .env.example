# IIPE App4 (Facilities Booking) — environment template
# Copy to .env and fill in the values (or ask the team for the shared dev env).

DATABASE_URL="postgresql://app4_user:CHANGE_ME@localhost:5432/sanapp_facilities_db"

SSO_BASE_URL="http://localhost:3000"
MAIN_BASE_URL="http://localhost:3001"
APP_BASE_URL="http://localhost:3005"

APP_CLIENT_ID="sanapp-facilities"
APP_CLIENT_SECRET="CHANGE_ME"

MAIN_API_KEY="CHANGE_ME"
SSO_ADMIN_KEY="CHANGE_ME"

# Serve under a base path when running behind Apache (production: /facilities)
# BASE_PATH="/facilities"
# NEXT_PUBLIC_BASE_PATH="/facilities"

APP_SESSION_SECRET="CHANGE_ME"
COOKIE_SECURE="false"
